# Copy this file to .env.local and fill in your Supabase project values.
# Find these in Supabase Dashboard -> Project Settings -> API.
# The anon key is safe to expose to the browser (protected by Row-Level Security).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key for admin/seed scripts. NEVER expose to the browser and NEVER commit .env.local.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Atomic billing rollout ------------------------------------------------
# Keep false until supabase/0179_atomic_billing_workflows.sql has been applied
# and its failure/retry checks have passed in this SAME environment. Turning
# this on first makes billing fail closed; it never falls back after an RPC
# error. Enable separately in Development/UAT/Production during rollout.
BILLING_ATOMIC_RPC_ENABLED=false

# ---- Online payments (Razorpay; disabled by default) -----------------------
# Do not set PAYMENT_PROVIDER until migrations 0179 and 0180 are applied and
# their retry/mismatch checks pass in the same non-production environment.
# The webhook endpoint is /api/payments/webhook.
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Timezone --------------------------------------------------------------
# The Node runtime (Vercel functions) defaults to UTC, so server-rendered dates
# and times — lead entry time, "today", etc. — show in UTC instead of local
# time. Set this so the whole app renders in India Standard Time. Must also be
# set as an environment variable in each Vercel project (Production + Preview),
# then redeploy. Date-only fields that intentionally pin UTC are unaffected.
TZ=Asia/Kolkata

# ---- Automation ------------------------------------------------------------
# Bearer token Vercel Cron sends to /api/cron/daily. If UNSET the endpoint 401s
# and ALL nightly automation is dead — renewals, reminders, SLA sweeps and lead
# digests. Set the same value in Vercel env AND in the cron job's header.
CRON_SECRET=generate-a-long-random-string

# ---- Website lead capture --------------------------------------------------
# Shared key your website sends as the X-Cureocity-Key header when POSTing to
# /api/leads/website. Unset = the endpoint rejects everything (fail closed).
WEBSITE_LEAD_SECRET=generate-a-different-long-random-string

# Who owns leads that arrive from the website. One staff id, or several
# comma-separated to share them out — the lead goes to whoever currently has
# fewer open leads, so it self-corrects when someone is on leave.
# Without it the lead is still captured but arrives unowned.
WEBSITE_LEAD_OWNER=s1,thamanna-nazer

# ---- Email (Resend) --------------------------------------------------------
# Unset = sendEmail() returns "skipped" but still writes to email_log, so the
# log will look like mail was sent when nothing left the building.
RESEND_API_KEY=
EMAIL_FROM=Cureocity <no-reply@cureo.city>

# ---- Instagram / Facebook Lead Ads ------------------------------------------
# Webhook receiver at /api/leads/meta. All three must be set or it stays inert
# (GET handshake fails, POST rejects on signature). See docs/meta-lead-capture.md
#
# A string YOU choose, entered in the Meta app's webhook config as the Verify
# Token; the app echoes Meta's challenge only when it matches.
META_VERIFY_TOKEN=choose-any-random-string
# The Meta App Secret (App Settings -> Basic). Used to verify X-Hub-Signature-256.
META_APP_SECRET=
# A long-lived Page access token with leads_retrieval. Used to fetch the actual
# lead answers from the Graph API — the webhook only sends an id.
META_PAGE_ACCESS_TOKEN=
# Who owns Instagram-ad leads. Same format as WEBSITE_LEAD_OWNER: one staff id
# or several comma-separated for least-loaded rotation.
META_LEAD_OWNER=s1,thamanna-nazer

# ---- Wati (WhatsApp) lead capture -------------------------------------------
# Webhook receiver at /api/leads/wati. Fails closed: without the secret set,
# every request is rejected. See docs/wati-lead-capture.md
#
# A string YOU choose. Wati's simple webhook UI has no header field, so it goes
# in the webhook URL as ?token=<this value>. The endpoint checks it constant-time.
WATI_WEBHOOK_SECRET=
# Who owns WhatsApp leads. Same format as WEBSITE_LEAD_OWNER: one staff id or
# several comma-separated for least-loaded rotation.
WATI_LEAD_OWNER=s1,thamanna-nazer

# --- AI assist (dietitian summaries / diet-plan draft) ---
# OpenAI API key. Without it the AI buttons return a clear "not configured" message.
OPENAI_API_KEY=

# Health Coach Copilot remains off even when other AI features use the key.
# Set true only after Cureocity approves the clinical/privacy launch controls.
HEALTH_COACH_COPILOT_ENABLED=false
# Super Admin pilot: requires migration 0183 first. It only stores reviewable
# operational drafts and never performs changes or sends messages.
STAFF_COPILOT_SUPER_ADMIN_ENABLED=false
# Shared emergency kill switch. Set true to disable every Cureocity Assistant
# task even when an individual role flag is on.
CUREOCITY_ASSISTANT_DISABLED=false
# Deterministic Staff navigation-checklist pilot. Requires migration 0186 but
# does not use OPENAI_API_KEY or read application records.
STAFF_COPILOT_STAFF_ENABLED=false
# Deterministic Front Desk operational-checklist pilot. Requires migrations
# 0186 and 0187 but does not use OPENAI_API_KEY or read application records.
STAFF_COPILOT_FRONT_DESK_ENABLED=false
# Deterministic Fitness Trainer workspace-checklist pilot. Requires migrations
# 0186 and 0188 but does not use OPENAI_API_KEY or read application records.
STAFF_COPILOT_FITNESS_TRAINER_ENABLED=false
# Deterministic Administrator governance-checklist pilot. Requires migrations
# 0186 and 0189 but does not use OPENAI_API_KEY or read application records.
STAFF_COPILOT_ADMINISTRATOR_ENABLED=false
# Optional model override (default gpt-4o-mini; use gpt-4o for higher quality).
OPENAI_MODEL=

# ---- PDF rendering -----------------------------------------------------------
# Turns a printable page into a real PDF file, so a document can be attached to
# WhatsApp and kept as a record of what was actually issued. Without these the
# app still prints from the browser; it just can't produce a file on its own.
#
# One provider is enough. Browserless is tried first if both are present.
BROWSERLESS_TOKEN=
# BROWSERLESS_URL=https://production-sfo.browserless.io   # override the region
# PDFSHIFT_API_KEY=

# Signs the short-lived, single-document token the renderer uses to read a print
# page it has no session for. Any long random string; generate with:
#   openssl rand -hex 32
DOC_TOKEN_SECRET=

# The app's own public address. The renderer fetches over the internet, so a
# relative path is useless and localhost would render the WRONG machine.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ---- WhatsApp document delivery (Wati, outbound) ------------------------------
# The inbound lead webhook above is separate. These send an approved template
# with a rendered PDF attached.
#
# Templates must be APPROVED BY META in the Wati dashboard first — nothing here
# can shortcut that. Category "Utility" (not Marketing), with a Document header.
WATI_API_ENDPOINT=https://live-mt-server.wati.io/YOUR_TENANT_ID
WATI_ACCESS_TOKEN=

# Optional — only if a template is named differently from the defaults:
#   diet_plan_ready · prescription_ready · lab_request_ready · consultation_summary_ready
# WATI_TEMPLATE_PLAN=
# WATI_TEMPLATE_RX=
# WATI_TEMPLATE_LAB=
# WATI_TEMPLATE_SUMMARY=
